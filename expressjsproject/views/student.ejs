
<!DOCTYPE html>
<html lang="mr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>दिवाळी संध्या | श्री राम कॉम्प्लेक्स</title>

  <!-- Bootstrap 5 CDN -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Google Font -->
  <link href="https://fonts.googleapis.com/css2?family=Hind+Devanagari:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    body {
      font-family: 'Hind Devanagari', sans-serif;
      background: #170b22;
      color: #fff;
    }

    .hero {
      min-height: 100vh;
      background:
        linear-gradient(135deg, rgba(30,5,20,.95), rgba(90,22,10,.82)),
        radial-gradient(circle at top, #ffb000, transparent 60%);
      display: flex;
      align-items: center;
      position: relative;
      overflow: hidden;
    }

    .hero::before {
      content: "🪔";
      position: absolute;
      font-size: 220px;
      opacity: .08;
      top: 10%;
      right: -30px;
    }

    .event-card {
      background: rgba(255,255,255,.07);
      border: 1px solid rgba(255,190,50,.5);
      border-radius: 24px;
      backdrop-filter: blur(10px);
      box-shadow: 0 15px 50px rgba(0,0,0,.3);
    }

    .gold {
      color: #ffd166;
    }

    .event-title {
      font-size: clamp(3rem, 8vw, 6rem);
      font-weight: 800;
      color: #ffd166;
      text-shadow: 0 5px 20px #ff6900;
    }

    .gold-btn {
      background: linear-gradient(45deg,#ff9d00,#ffdc73);
      border: none;
      color: #521600;
      font-weight: 800;
      border-radius: 50px;
      padding: 13px 35px;
    }

    .gold-btn:hover {
      background: #fff0b5;
      color: #521600;
    }

    .detail-box {
      background: rgba(255,255,255,.08);
      border-radius: 15px;
      padding: 20px 10px;
      height: 100%;
    }

    .detail-icon {
      font-size: 35px;
    }

    .free-entry {
      display: inline-block;
      border: 2px solid #ffd166;
      border-radius: 50px;
      padding: 10px 28px;
      color: #ffd166;
      font-size: 1.4rem;
      font-weight: 700;
    }

    .footer {
      background: #0c0611;
      padding: 20px;
      text-align: center;
    }

    .glow {
      color: #ffd166;
      text-shadow: 0 0 15px #ff8c00;
    }
  </style>
</head>

<body>

<section class="hero py-5">
  <div class="container position-relative">

    <div class="text-center mb-4">
      <h2 class="gold fw-bold">श्री राम कॉम्प्लेक्स</h2>
      <p class="text-white-50">
        एव्हरग्रीन लेआउट, सेक्टर नं. २, विरार पश्चिम
      </p>
      <div class="mx-auto bg-warning" style="height:3px;width:100px"></div>
    </div>

    <div class="event-card p-4 p-md-5 text-center mx-auto"
         style="max-width:850px">

      <p class="gold fs-5 mb-2">सस्नेह निमंत्रण</p>

      <div class="display-1 mb-2">🪔</div>

      <h1 class="event-title">दिवाळी संध्या</h1>

      <h3 class="fw-bold mb-4">
        ✨ सांस्कृतिक महोत्सव ✨
      </h3>

      <p class="fs-5 text-white-50">
        परंपरा • संस्कृती • भक्ती • मनोरंजन
      </p>

      <hr class="border-warning opacity-50 my-4">

      <h2 class="gold fw-bold mb-3">
        रामलीला / दशावतार
      </h2>

      <p class="fs-5 mb-4">
        भव्य नाट्यप्रयोग आणि सांस्कृतिक सादरीकरणाचा आनंद घ्या!
      </p>

      <div class="row g-3 mb-4">

        <div class="col-12 col-md-4">
          <div class="detail-box">
            <div class="detail-icon">📅</div>
            <h5 class="gold mt-2">दिनांक</h5>
            <h4 class="fw-bold">शनिवार</h4>
            <p class="mb-0">७ नोव्हेंबर</p>
          </div>
        </div>

        <div class="col-12 col-md-4">
          <div class="detail-box">
            <div class="detail-icon">🕕</div>
            <h5 class="gold mt-2">वेळ</h5>
            <h4 class="fw-bold">सायंकाळी</h4>
            <p class="mb-0">६ वाजल्यापासून</p>
          </div>
        </div>

        <div class="col-12 col-md-4">
          <div class="detail-box">
            <div class="detail-icon">📍</div>
            <h5 class="gold mt-2">स्थळ</h5>
            <h5 class="fw-bold">श्री राम कॉम्प्लेक्स</h5>
            <p class="mb-0">विरार पश्चिम</p>
          </div>
        </div>

      </div>

      <div class="mb-4">
        <span class="free-entry">
          प्रवेश सर्वांसाठी विनामूल्य!
        </span>
      </div>

      <h4 class="fw-bold mb-4">
        आपल्या संपूर्ण परिवारासह जरूर या!
      </h4>

      <button class="btn gold-btn btn-lg"
        onclick="shareEvent()">
        📲 कार्यक्रम शेअर करा
      </button>

      <p class="mt-4 mb-0 gold fs-4 fw-bold">
        जय श्री राम! 🙏
      </p>

    </div>
  </div>
</section>

<footer class="footer">
  <p class="mb-1">आयोजक: श्री राम कॉम्प्लेक्स परिवार</p>
  <small class="text-white-50">
    एक परिवार • एक उत्सव • एक संस्कृती
  </small>
</footer>

<script>
async function shareEvent() {
  const text = `🪔 दिवाळी संध्या 🪔

श्री राम कॉम्प्लेक्स आयोजित
भव्य सांस्कृतिक महोत्सव!

📅 शनिवार, ७ नोव्हेंबर
🕕 सायंकाळी ६ वाजल्यापासून
📍 श्री राम कॉम्प्लेक्स, विरार पश्चिम

रामलीला / दशावतार नाट्यप्रयोग

प्रवेश सर्वांसाठी विनामूल्य!

आपल्या परिवारासह जरूर या!
जय श्री राम! 🙏`;

  if (navigator.share) {
    await navigator.share({
      title: 'दिवाळी संध्या',
      text: text
    });
  } else {
    await navigator.clipboard.writeText(text);
    alert('Invitation copied!');
  }
}
</script>

</body>
</html>
